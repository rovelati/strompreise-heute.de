---
import Layout from '../../layouts/Layout.astro';
import UpdatedAt from '../../components/UpdatedAt.astro';
import AdSlot from '../../components/AdSlot.astro';
import { guides } from '../../data/guides';
import data from '../../data/strompreise_summary.json';

const today = data.today;
const title = 'Ratgeber: Dynamische Stromtarife, Börse und Netz | StrompreiseHeute.de';
const description =
  'Ausführliche Anleitungen zu dynamischen Stromtarifen, negativen Preisen, E-Auto, Wärmepumpe, § 14a EnWG und Smart Meter — mit dem heutigen Börsenpreis.';
---

<Layout
  title={title}
  description={description}
  canonical="https://strompreise-heute.de/ratgeber/"
  currentPrice={today.currentPriceBoerseCt}
  currentAmpel={today.currentAmpel}
>
  <div class="bg-slate-900 border-b border-slate-800 py-12 px-4 sm:px-6 lg:px-8 text-white">
    <div class="max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-400/10 border border-amber-400/30 text-amber-400 text-xs font-semibold mb-4">
        Verbraucher-Leitfaden
      </div>
      <h1 class="text-3xl sm:text-4xl font-black tracking-tight mb-3">
        Ratgeber zu Börsenstrom und dynamischen Tarifen
      </h1>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-3xl">
        Jede Anleitung beantwortet eine eigene Frage: Tarifwechsel, negative Preise, Zusammensetzung der Rechnung, Laden, Heizen, Netzentgelt und Zähler. Die Preisboxen nutzen den aktuellen Datenstand.
      </p>
      <p class="mt-4 text-xs text-slate-400">
        <UpdatedAt />
        <span class="mx-2">·</span>
        Heute im Schnitt {today.avgBoerseCt.toFixed(2)} ct/kWh Börse, günstigste Stunde {today.minHour} Uhr
      </p>
    </div>
  </div>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300">
      Der Day-Ahead-Preis gilt in der gesamten Gebotszone Deutschland/Luxemburg. Was sich lokal ändert, sind Netzentgelt und Konzessionsabgabe. Die Artikel erklären die Regeln, die
      <a href="/methodik/" class="text-amber-600 dark:text-amber-400 font-semibold hover:underline">Methodik</a>
      die Rechenformel, das
      <a href="/glossar/" class="text-amber-600 dark:text-amber-400 font-semibold hover:underline">Glossar</a>
      die Begriffe.
    </p>

    <div class="grid gap-4">
      {guides.map((guide) => (
        <a
          href={`/ratgeber/${guide.slug}/`}
          class="block p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-amber-400 transition-colors"
        >
          <div class="text-[11px] font-bold uppercase tracking-wider text-amber-500 mb-1">{guide.kicker}</div>
          <h2 class="text-lg font-black text-slate-900 dark:text-white">{guide.h1}</h2>
          <p class="text-sm text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">{guide.intro}</p>
          <div class="text-xs font-bold text-amber-600 dark:text-amber-400 mt-3">Weiterlesen</div>
        </a>
      ))}
    </div>

    <AdSlot />

    <section class="p-6 rounded-3xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-sm leading-relaxed text-slate-600 dark:text-slate-300 space-y-2">
      <h2 class="text-base font-bold text-slate-900 dark:text-white">Direkt zu den Preisen</h2>
      <p>
        <a href="/" class="font-semibold text-amber-600 dark:text-amber-400 hover:underline">Börsenpreis heute</a>,
        <a href="/morgen/" class="font-semibold text-amber-600 dark:text-amber-400 hover:underline">Preise für morgen</a>,
        <a href="/stromampel/" class="font-semibold text-amber-600 dark:text-amber-400 hover:underline">Stromampel</a>,
        <a href="/verlauf/" class="font-semibold text-amber-600 dark:text-amber-400 hover:underline">7-Tage-Verlauf</a>,
        <a href="/rechner/" class="font-semibold text-amber-600 dark:text-amber-400 hover:underline">Ersparnisrechner</a>.
      </p>
    </section>
  </main>
</Layout>
