---
import Layout from '../../layouts/Layout.astro';
import HourlyChart from '../../components/HourlyChart.astro';
import TariffCalculator from '../../components/TariffCalculator.astro';
import AdSlot from '../../components/AdSlot.astro';
import data from '../../data/strompreise_summary.json';

export function getStaticPaths() {
  return data.bundeslaender.map((b) => ({
    params: { slug: b.slug },
    props: { state: b }
  }));
}

const { state } = Astro.props;
const today = data.today;

const title = `Börsenstrompreis ${state.name} aktuell — Stündliche Strompreise & Netzentgelte | StrompreiseHeute.de`;
const description = `Aktuelle stündliche Strompreise in ${state.name} (${state.capital}). Netzentgelte von ${state.grid_operator} (${state.avg_netzentgelt_ct.toFixed(2)} ct), Grundversorger-Vergleich und Sparpotenzial bis ${state.potential_savings_eur} € / Jahr.`;
---

<Layout
  title={title}
  description={description}
  canonical={`https://strompreise-heute.de/bundesland/${state.slug}/`}
  currentPrice={today.currentPriceBoerseCt}
  currentAmpel={today.currentAmpel}
>
  <!-- Header / Breadcrumbs -->
  <div class="bg-slate-900 border-b border-slate-800 py-12 px-4 sm:px-6 lg:px-8 text-white relative overflow-hidden">
    <div class="max-w-7xl mx-auto">
      <nav class="flex items-center gap-2 text-xs text-slate-400 mb-4 font-medium" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition">Startseite</a>
        <span>/</span>
        <span class="text-slate-500">Bundesländer</span>
        <span>/</span>
        <span class="text-amber-400 font-bold">{state.name}</span>
      </nav>

      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/20 border border-blue-400/30 text-blue-300 text-xs font-semibold mb-4">
        <span>📍</span> Bundesland-Profil {state.code}
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight mb-3">
        Strompreise in <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-yellow-300">{state.name}</span> heute
      </h1>

      <p class="text-slate-300 text-sm sm:text-base max-w-3xl leading-relaxed">
        {state.description}
      </p>
    </div>
  </div>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    <!-- State KPI Metrics -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
        <span class="text-xs uppercase font-bold text-slate-500">Regionales Netzentgelt</span>
        <div class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white font-mono mt-1">
          {state.avg_netzentgelt_ct.toFixed(2)} <span class="text-xs font-normal text-slate-500">ct/kWh</span>
        </div>
        <div class="text-[11px] text-slate-400 mt-1">{state.grid_operator}</div>
      </div>

      <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
        <span class="text-xs uppercase font-bold text-slate-500">Grundversorger Ø</span>
        <div class="text-2xl sm:text-3xl font-black text-rose-500 font-mono mt-1">
          {state.avg_grundversorger_ct.toFixed(2)} <span class="text-xs font-normal">ct/kWh</span>
        </div>
        <div class="text-[11px] text-slate-400 mt-1">Festarif Standard</div>
      </div>

      <div class="p-5 rounded-2xl bg-emerald-500/10 border border-emerald-500/30">
        <span class="text-xs uppercase font-bold text-emerald-600 dark:text-emerald-400">Dynamischer Tarif Ø</span>
        <div class="text-2xl sm:text-3xl font-black text-emerald-600 dark:text-emerald-400 font-mono mt-1">
          {state.avg_dynamic_ct.toFixed(2)} <span class="text-xs font-normal">ct/kWh</span>
        </div>
        <div class="text-[11px] text-slate-500 mt-1">Börsenstrom geglättet</div>
      </div>

      <div class="p-5 rounded-2xl bg-amber-500/10 border border-amber-500/30">
        <span class="text-xs uppercase font-bold text-amber-600 dark:text-amber-400">Mögliche Ersparnis</span>
        <div class="text-2xl sm:text-3xl font-black text-amber-600 dark:text-amber-400 font-mono mt-1">
          bis {state.potential_savings_eur} €
        </div>
        <div class="text-[11px] text-slate-500 mt-1">pro Jahr für 4.000 kWh Haushalt</div>
      </div>
    </div>

    <!-- Ad Banner -->
    <AdSlot />

    <!-- 24-Hour Price Curve for State -->
    <section>
      <HourlyChart todayHours={today.hours} />
    </section>

    <!-- State Energy Details Card -->
    <section class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-sm">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4">
        Stromnetz & Netzbetreiber in {state.name} ({state.capital})
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
        <div>
          <p class="mb-3">
            In <strong>{state.name}</strong> werden die regionalen Stromnetze maßgeblich von <strong>{state.grid_operator}</strong> betrieben. Die Netzentgelte schlagen im Landesdurchschnitt mit <strong>{state.avg_netzentgelt_ct.toFixed(2)} ct/kWh</strong> zu Buche.
          </p>
          <p>
            Im Vergleich zu starren Grundversorgungstarifen von durchschnittlich {state.avg_grundversorger_ct.toFixed(2)} ct/kWh können Verbraucher mit dynamischen Stromtarifen rund <strong>{(state.avg_grundversorger_ct - state.avg_dynamic_ct).toFixed(2)} ct pro Kilowattstunde</strong> einsparen.
          </p>
        </div>
        <div class="bg-slate-50 dark:bg-slate-800/60 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 space-y-2 text-xs">
          <div class="font-bold text-slate-900 dark:text-white text-sm mb-2">Wichtige Kennzahlen für {state.name}:</div>
          <div class="flex justify-between py-1 border-b border-slate-200 dark:border-slate-700">
            <span>Landeshauptstadt:</span>
            <span class="font-bold text-slate-900 dark:text-white">{state.capital}</span>
          </div>
          <div class="flex justify-between py-1 border-b border-slate-200 dark:border-slate-700">
            <span>Netzbetreiber:</span>
            <span class="font-bold text-slate-900 dark:text-white">{state.grid_operator}</span>
          </div>
          <div class="flex justify-between py-1 border-b border-slate-200 dark:border-slate-700">
            <span>Netzentgelt (Durchschnitt):</span>
            <span class="font-mono font-bold">{state.avg_netzentgelt_ct.toFixed(2)} ct/kWh</span>
          </div>
          <div class="flex justify-between py-1">
            <span class="text-emerald-600 dark:text-emerald-400 font-bold">Ersparnis-Potenzial:</span>
            <span class="font-mono font-bold text-emerald-600 dark:text-emerald-400">bis {state.potential_savings_eur} € / Jahr</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Savings Calculator on State Level -->
    <section>
      <TariffCalculator />
    </section>

    <!-- Other States Navigation -->
    <section class="space-y-4">
      <h3 class="text-lg font-bold text-slate-900 dark:text-white">
        Strompreise in den weiteren Bundesländern:
      </h3>
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-6 gap-2.5 text-xs">
        {data.bundeslaender.filter((b) => b.slug !== state.slug).map((b) => (
          <a
            href={`/bundesland/${b.slug}/`}
            class="p-3 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 hover:border-amber-400 transition-colors truncate block"
          >
            <div class="font-bold text-slate-900 dark:text-white truncate">{b.name}</div>
            <div class="text-[10px] text-slate-400">Netz: {b.avg_netzentgelt_ct.toFixed(1)} ct</div>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>
