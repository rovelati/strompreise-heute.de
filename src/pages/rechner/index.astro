---
import Layout from '../../layouts/Layout.astro';
import TariffCalculator from '../../components/TariffCalculator.astro';
import AdSlot from '../../components/AdSlot.astro';
import data from '../../data/strompreise_summary.json';

const today = data.today;

const title = "Dynamischer Stromtarif Rechner 2026 — Ersparnis berechnen | StrompreiseHeute.de";
const description = "Kostenloser Rechner für dynamische Stromtarife (Tibber, Ostrom, Check24). Berechnen Sie Ihr persönliches Sparpotenzial gegenüber der Grundversorgung und Festpreisen.";
---

<Layout
  title={title}
  description={description}
  canonical="https://strompreise-heute.de/rechner/"
  currentPrice={today.currentPriceBoerseCt}
  currentAmpel={today.currentAmpel}
>
  <div class="bg-slate-900 border-b border-slate-800 py-12 px-4 sm:px-6 lg:px-8 text-white relative overflow-hidden">
    <div class="max-w-7xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-400/10 border border-amber-400/30 text-amber-400 text-xs font-semibold mb-4">
        <span>⚡</span> Interaktiver Kostenrechner
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight mb-3">
        Dynamischer <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-yellow-300">Stromtarif Rechner</span>
      </h1>
      <p class="text-slate-300 text-sm sm:text-base max-w-3xl leading-relaxed">
        Ermitteln Sie in wenigen Klicks, wie viel Geld Sie mit einem dynamischen Börsentarif im Vergleich zu klassischen Grundversorgern oder starren Festpreistarifen einsparen.
      </p>
    </div>
  </div>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    <!-- Interactive Calculator -->
    <TariffCalculator />

    <AdSlot />

    <!-- Comparison Table: Traditional vs Dynamic -->
    <section class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-sm">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-6">
        Klassischer Festpreistarif vs. Dynamischer Börsentarif im Direktvergleich
      </h2>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-slate-200 dark:border-slate-800 text-xs font-bold text-slate-500 uppercase tracking-wider">
              <th class="py-3 px-4">Kriterium</th>
              <th class="py-3 px-4">Klassischer Festtarif</th>
              <th class="py-3 px-4 text-emerald-600 dark:text-emerald-400 font-bold">Dynamischer Börsentarif</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800 font-medium">
            <tr>
              <td class="py-3 px-4 font-bold text-slate-900 dark:text-white">Preisstruktur</td>
              <td class="py-3 px-4 text-slate-600 dark:text-slate-400">Starrer Preis (oft 36–44 ct/kWh rund um die Uhr)</td>
              <td class="py-3 px-4 text-emerald-600 dark:text-emerald-400 font-bold">Stündlich wechselnder Börsenpreis (ab 0 ct/kWh)</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-bold text-slate-900 dark:text-white">Vertragslaufzeit</td>
              <td class="py-3 px-4 text-slate-600 dark:text-slate-400">12 bis 24 Monate Bindung</td>
              <td class="py-3 px-4 text-emerald-600 dark:text-emerald-400 font-bold">Monatlich kündbar (hohe Flexibilität)</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-bold text-slate-900 dark:text-white">Voraussetzung</td>
              <td class="py-3 px-4 text-slate-600 dark:text-slate-400">Jeder Standardzähler (Ferraris oder digital)</td>
              <td class="py-3 px-4 text-slate-700 dark:text-slate-300">Smart Meter (iMSys) oder moderner Zähler mit Pulse/Sensor</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-bold text-slate-900 dark:text-white">Gefahr von Preiserhöhungen</td>
              <td class="py-3 px-4 text-slate-600 dark:text-slate-400">Versteckte Erhöhungen nach Ablauf der Preisgarantie</td>
              <td class="py-3 px-4 text-emerald-600 dark:text-emerald-400 font-bold">Vollkommen transparent: 1:1 Börsenweitergabe</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-bold text-slate-900 dark:text-white">Vorteil bei E-Auto / Wärmepumpe</td>
              <td class="py-3 px-4 text-slate-600 dark:text-slate-400">Kein Vorteil (hohe Ladekosten auch nachts)</td>
              <td class="py-3 px-4 text-emerald-600 dark:text-emerald-400 font-bold">Riesiges Sparpotenzial (Laden zu Niedrigstpreisen)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</Layout>
