---
import Layout from '../layouts/Layout.astro';
import StromampelWidget from '../components/StromampelWidget.astro';
import HourlyChart from '../components/HourlyChart.astro';
import TariffCalculator from '../components/TariffCalculator.astro';
import RegionalMap from '../components/RegionalMap.astro';
import AdSlot from '../components/AdSlot.astro';
import data from '../data/strompreise_summary.json';

const title = "Börsenstrompreis heute — Stündliche Strompreise & Stromampel aktuell | StrompreiseHeute.de";
const description = "Aktueller Börsenstrompreis heute in Deutschland stündlich im Live-Ticker. Offizielle SMARD / EPEX Spot Auktionsdaten, Stromampel (Grün/Gelb/Rot), Preise für morgen ab 13 Uhr und Ersparnisrechner.";

const today = data.today;
const tomorrow = data.tomorrow;
---

<Layout
  title={title}
  description={description}
  canonical="https://strompreise-heute.de/"
  currentPrice={today.currentPriceBoerseCt}
  currentAmpel={today.currentAmpel}
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950 text-white pt-10 pb-14 px-4 sm:px-6 lg:px-8 border-b border-slate-800 relative overflow-hidden">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-8">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-400/10 border border-amber-400/30 text-amber-400 text-xs font-semibold mb-4">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Live-Börsendaten Deutschland / Luxemburg ({today.weekday}, {today.formattedDate})
          </div>

          <h1 class="text-3xl sm:text-5xl font-black tracking-tight leading-tight">
            Börsenstrompreis <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-yellow-300">heute</span> & <br class="hidden sm:inline" />
            stündliche Stromampel
          </h1>

          <p class="text-slate-300 text-sm sm:text-base max-w-2xl mt-3 leading-relaxed">
            Echtzeit-Großhandelspreise der Strombörse EPEX Spot SE via Bundesnetzagentur (SMARD). Finden Sie die günstigsten Stunden zum Laden Ihres E-Autos, für die Wärmepumpe oder Haushaltsgeräte.
          </p>
        </div>

        <!-- Quick Jump to Tomorrow -->
        <div class="shrink-0 bg-slate-950/80 p-4 rounded-2xl border border-slate-800 text-xs">
          <div class="text-slate-400 mb-1">Preise für morgen:</div>
          {tomorrow.available ? (
            <a href="/morgen/" class="inline-flex items-center gap-1.5 font-bold text-emerald-400 hover:text-emerald-300">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Morgen verfügbar (Ø {tomorrow.avgBoerseCt} ct) →
            </a>
          ) : (
            <span class="text-amber-400 font-semibold flex items-center gap-1.5">
              <span>⏳</span> Ab ca. 13:00 Uhr verfügbar
            </span>
          )}
        </div>
      </div>

      <!-- Key Metrics Row -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <!-- Current Hour -->
        <div class="bg-slate-950/90 border border-slate-800 p-5 rounded-2xl shadow-sm">
          <div class="flex items-center justify-between text-xs text-slate-400 mb-1 font-bold">
            <span>Aktuelle Stunde ({today.currentHour}:00 Uhr)</span>
            <span class={`w-2 h-2 rounded-full ${today.currentAmpel === 'red' ? 'bg-rose-500' : today.currentAmpel === 'yellow' ? 'bg-amber-400' : 'bg-emerald-400'} animate-pulse`}></span>
          </div>
          <div class="text-2xl sm:text-3xl font-black text-amber-400 font-mono">
            {today.currentPriceBoerseCt.toFixed(2)} <span class="text-xs font-semibold text-slate-400">ct/kWh</span>
          </div>
          <div class="text-[11px] text-slate-400 mt-1">
            Endpreis ca. <strong>{today.currentPriceConsumerCt.toFixed(2)} ct</strong>
          </div>
        </div>

        <!-- Day Average -->
        <div class="bg-slate-950/90 border border-slate-800 p-5 rounded-2xl shadow-sm">
          <div class="text-xs text-slate-400 mb-1 font-bold uppercase tracking-wider">Tagesdurchschnitt</div>
          <div class="text-2xl sm:text-3xl font-black text-white font-mono">
            {today.avgBoerseCt.toFixed(2)} <span class="text-xs font-semibold text-slate-400">ct/kWh</span>
          </div>
          <div class="text-[11px] text-slate-400 mt-1">
            Endpreis Ø ~{today.avgConsumerCt.toFixed(2)} ct
          </div>
        </div>

        <!-- Minimum Price Hour -->
        <div class="bg-slate-950/90 border border-slate-800 p-5 rounded-2xl shadow-sm">
          <div class="text-xs text-emerald-400 mb-1 font-bold uppercase tracking-wider">Günstigste Stunde</div>
          <div class="text-2xl sm:text-3xl font-black text-emerald-400 font-mono">
            {today.minPriceCt.toFixed(2)} <span class="text-xs font-semibold text-slate-400">ct/kWh</span>
          </div>
          <div class="text-[11px] text-slate-400 mt-1">
            Um <strong>{today.minHour} Uhr</strong> (Beste Ladezeit)
          </div>
        </div>

        <!-- Maximum Price Hour -->
        <div class="bg-slate-950/90 border border-slate-800 p-5 rounded-2xl shadow-sm">
          <div class="text-xs text-rose-400 mb-1 font-bold uppercase tracking-wider">Teuerste Stunde (Peak)</div>
          <div class="text-2xl sm:text-3xl font-black text-rose-400 font-mono">
            {today.maxPriceCt.toFixed(2)} <span class="text-xs font-semibold text-slate-400">ct/kWh</span>
          </div>
          <div class="text-[11px] text-slate-400 mt-1">
            Um <strong>{today.maxHour} Uhr</strong> (Stromfresser meiden)
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Layout -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    <!-- Live Stromampel Section -->
    <section id="stromampel">
      <StromampelWidget
        currentAmpel={today.currentAmpel}
        currentPriceBoerse={today.currentPriceBoerseCt}
        currentPriceConsumer={today.currentPriceConsumerCt}
        hours={today.hours}
      />
    </section>

    <!-- Ad Banner 1 -->
    <AdSlot />

    <!-- 24-Hour Interactive Chart Section -->
    <section id="chart">
      <HourlyChart todayHours={today.hours} />
    </section>

    <!-- Tomorrow Preview Section -->
    <section class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-amber-500 font-mono">Day-Ahead Auktion</span>
          <h2 class="text-2xl font-black text-slate-900 dark:text-white">
            Strompreise für morgen ({tomorrow.formattedDate})
          </h2>
        </div>
        <a href="/morgen/" class="text-xs font-bold text-amber-500 hover:text-amber-400 flex items-center gap-1">
          Vollständige Morgen-Tabelle →
        </a>
      </div>

      {tomorrow.available ? (
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
          <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-800">
            <span class="text-xs text-slate-500 font-bold">Morgen Durchschnitt</span>
            <div class="text-2xl font-black text-slate-900 dark:text-white font-mono mt-1">
              {tomorrow.avgBoerseCt} ct/kWh
            </div>
            <div class="text-xs text-slate-400 mt-1">Endpreis ca. ~{tomorrow.avgConsumerCt} ct</div>
          </div>

          <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30">
            <span class="text-xs text-emerald-600 dark:text-emerald-400 font-bold">Tiefstpreis morgen</span>
            <div class="text-2xl font-black text-emerald-600 dark:text-emerald-400 font-mono mt-1">
              {tomorrow.minPriceCt} ct/kWh
            </div>
            <div class="text-xs text-slate-500 mt-1">Um {tomorrow.minHour} Uhr</div>
          </div>

          <div class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30">
            <span class="text-xs text-rose-600 dark:text-rose-400 font-bold">Höchstpreis morgen</span>
            <div class="text-2xl font-black text-rose-600 dark:text-rose-400 font-mono mt-1">
              {tomorrow.maxPriceCt} ct/kWh
            </div>
            <div class="text-xs text-slate-500 mt-1">Um {tomorrow.maxHour} Uhr</div>
          </div>
        </div>
      ) : (
        <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-800 text-center space-y-2">
          <div class="text-2xl">⏰</div>
          <div class="font-bold text-slate-900 dark:text-white text-base">
            Preise für morgen werden gegen 13:00 Uhr veröffentlicht
          </div>
          <p class="text-xs text-slate-500 max-w-lg mx-auto">
            Die europäische Strombörse EPEX Spot SE schließt die tägliche Day-Ahead Auktion um 12:00 Uhr. Nach Prüfung durch die Bundesnetzagentur (SMARD) stehen die stündlichen Stromtarife für den kommenden Tag hier minutengenau bereit.
          </p>
        </div>
      )}
    </section>

    <!-- Dynamic Tariff Savings Calculator -->
    <section id="rechner">
      <TariffCalculator />
    </section>

    <!-- Interactive Leaflet Map of 16 Bundesländer -->
    <section id="karte">
      <RegionalMap bundeslaender={data.bundeslaender} />
    </section>

    <!-- 16 Bundesländer Grid -->
    <section class="space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-2xl font-black text-slate-900 dark:text-white">
            Strompreise nach Bundesland & Netzbetreiber
          </h2>
          <p class="text-xs sm:text-sm text-slate-500">
            Regionale Netzentgelte und Grundversorger-Tarife im Vergleich
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {data.bundeslaender.map((b) => (
          <a
            href={`/bundesland/${b.slug}/`}
            class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-amber-400 dark:hover:border-amber-400 transition-all group block shadow-xs"
          >
            <div class="flex items-center justify-between mb-2">
              <span class="font-bold text-slate-900 dark:text-white group-hover:text-amber-500 transition-colors">
                {b.name}
              </span>
              <span class="text-xs font-mono font-bold text-slate-400 group-hover:translate-x-1 transition-transform">
                →
              </span>
            </div>
            <div class="text-xs text-slate-500 mb-2">
              Hauptstadt: {b.capital}
            </div>
            <div class="pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs">
              <span class="text-slate-500">Netzentgelt:</span>
              <span class="font-mono font-bold text-slate-700 dark:text-slate-300">{b.avg_netzentgelt_ct.toFixed(2)} ct</span>
            </div>
            <div class="mt-1 flex items-center justify-between text-xs">
              <span class="text-emerald-600 dark:text-emerald-400 font-semibold">Sparpotenzial:</span>
              <span class="font-mono font-bold text-emerald-600 dark:text-emerald-400">bis {b.potential_savings_eur} €/J.</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Top German Cities Directory -->
    <section class="bg-slate-100 dark:bg-slate-900/60 rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-slate-800">
      <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-4">
        Großstädte in Deutschland: Börsenstrom & Netzgebühren
      </h3>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 text-xs">
        {data.topCities.map((c) => (
          <a
            href={`/bundesland/${c.state.toLowerCase().replace(/[^a-z0-9]+/g, '-')}/`}
            class="p-3 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 hover:border-amber-400 transition-colors"
          >
            <div class="font-bold text-slate-900 dark:text-white">{c.name}</div>
            <div class="text-[11px] text-slate-500">{c.state} • {c.population}</div>
          </a>
        ))}
      </div>
    </section>

    <!-- Educational SEO Guide Section -->
    <section class="max-w-4xl mx-auto space-y-6 pt-6">
      <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white text-center">
        Wissenswertes über Börsenstrompreise & dynamische Tarife
      </h2>

      <div class="space-y-4 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
        <div class="p-6 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800">
          <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">
            Was ist der Börsenstrompreis (EPEX Spot)?
          </h3>
          <p>
            Der Börsenstrompreis ist der Einkaufspreis für elektrische Energie an der europäischen Strombörse EPEX Spot SE in Paris/Leipzig. Im sogenannten <strong>Day-Ahead-Handel</strong> wird der Strom für jede einzelne der 24 Stunden des Folgetages per Auktion gehandelt. Der Preis entsteht rein durch Angebot und Nachfrage: Scheint die Sonne intensiv und weht starker Wind, sinkt der Preis drastisch. In windstillen Abendstunden (17:00–21:00 Uhr) bei hoher industrieller und privater Nachfrage steigt der Preis dagegen an.
          </p>
        </div>

        <div class="p-6 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800">
          <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">
            Wie funktioniert ein dynamischer Stromtarif?
          </h3>
          <p>
            Im Gegensatz zu klassischen Festpreistarifen (bei denen Sie 12 bis 24 Monate lang denselben Betrag pro kWh zahlen, oft 35 bis 45 ct/kWh), geben Anbieter wie Tibber, Ostrom oder 1KOMMA5° den stündlichen Börsenpreis 1:1 an den Verbraucher weiter. Sie zahlen den tatsächlichen Börsenpreis der jeweiligen Stunde zuzüglich fester Netzentgelte, Steuern und Umlagen. Wer flexible Großverbraucher wie Wärmepumpen, Batteriespeicher oder Elektroautos in günstige Stunden verlegt, spart jährlich mehrere hundert Euro.
          </p>
        </div>

        <div class="p-6 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800">
          <h3 class="text-base font-bold text-emerald-600 dark:text-emerald-400 mb-2">
            Was sind negative Strompreise?
          </h3>
          <p>
            An Feiertagen, Wochenenden oder besonders stürmischen und sonnigen Tagen speisen Windkraft- und Photovoltaikanlagen mehr Strom ins Netz ein, als die Industrie und Haushalte verbrauchen können. Da Großkraftwerke nicht beliebig schnell gedrosselt werden können, fällt der Börsenpreis unter 0,00 €/MWh. Bei negativen Börsenpreisen bekommen Abnehmer Geld für den Strombezug, wodurch der Endverbraucherpreis spürbar sinkt.
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>
