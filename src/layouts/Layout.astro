---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  currentPrice?: number;
  currentAmpel?: string;
}

const {
  title,
  description,
  canonical = 'https://strompreise-heute.de/',
  currentPrice,
  currentAmpel = 'yellow'
} = Astro.props;

const siteUrl = 'https://strompreise-heute.de';
---

<!doctype html>
<html lang="de" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="StrompreiseHeute.de" />
    <meta property="og:locale" content="de_DE" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Solar / Lunar Dark Mode Theme Init Script (Zero Flash) -->
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        if (saved === 'light') {
          document.documentElement.classList.remove('dark');
        } else if (saved === 'dark') {
          document.documentElement.classList.add('dark');
        } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Google Consent Mode v2 Default (DSGVO compliant) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'analytics_storage': 'denied'
      });
    </script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-R7JR4JJQCL"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-R7JR4JJQCL');
    </script>

    <!-- Google AdSense Account Verification -->
    <meta name="google-adsense-account" content="ca-pub-2168172914069272" />
    <!-- Google AdSense Script -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2168172914069272" crossorigin="anonymous"></script>

    <!-- Schema.org Global WebSite & Organization -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${siteUrl}/#website`,
          "url": siteUrl,
          "name": "StrompreiseHeute.de",
          "description": "Aktuelle stündliche Börsenstrompreise & Stromampel Deutschland (EPEX Spot / SMARD)",
          "publisher": { "@id": `${siteUrl}/#organization` },
          "inLanguage": "de-DE"
        },
        {
          "@type": "Organization",
          "@id": `${siteUrl}/#organization`,
          "name": "StrompreiseHeute Deutschland",
          "url": siteUrl,
          "logo": {
            "@type": "ImageObject",
            "url": `${siteUrl}/favicon.svg`
          }
        }
      ]
    })} />
  </head>

  <body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 min-h-screen flex flex-col font-sans antialiased selection:bg-amber-500 selection:text-slate-950">
    <!-- Top Trust Ticker -->
    <header class="bg-slate-900 border-b border-slate-800 text-slate-300 text-xs py-1.5 px-4 hidden sm:block">
      <div class="max-w-7xl mx-auto flex justify-between items-center">
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center gap-1.5 text-amber-400 font-semibold">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
            EPEX Spot Day-Ahead DE-LU
          </span>
          <span class="text-slate-500">•</span>
          <span>Offizielle SMARD-Daten der Bundesnetzagentur</span>
        </div>
        <div class="flex items-center gap-4 text-slate-400">
          <span>Täglich aktualisiert um 13:00 Uhr</span>
          <span>•</span>
          <a href="/stromampel/" class="hover:text-amber-400 transition">Stromampel</a>
          <span>•</span>
          <a href="/morgen/" class="hover:text-amber-400 transition">Preise für morgen</a>
        </div>
      </div>
    </header>

    <!-- Main Navigation Bar -->
    <nav class="sticky top-0 z-40 bg-white/90 dark:bg-slate-950/90 backdrop-blur-md border-b border-slate-200 dark:border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-amber-500 to-yellow-400 flex items-center justify-center text-slate-950 font-black shadow-md shadow-amber-500/20 group-hover:scale-105 transition-transform">
            ⚡
          </div>
          <div>
            <span class="font-black text-lg tracking-tight text-slate-900 dark:text-white flex items-center">
              Strompreise<span class="text-amber-500">Heute</span><span class="text-xs font-mono text-slate-400">.de</span>
            </span>
            <span class="block text-[9px] uppercase font-bold tracking-widest text-slate-500 dark:text-slate-400 -mt-1">Börsenstrom & Ampel</span>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <div class="hidden md:flex items-center gap-6 text-sm font-semibold text-slate-700 dark:text-slate-300">
          <a href="/" class="hover:text-amber-500 transition-colors">Börsenstrom Heute</a>
          <a href="/stromampel/" class="hover:text-amber-500 transition-colors">Stromampel</a>
          <a href="/morgen/" class="hover:text-amber-500 transition-colors">Preise Morgen</a>
          <a href="/rechner/" class="hover:text-amber-500 transition-colors">Ersparnisrechner</a>
          <a href="/ratgeber/" class="hover:text-amber-500 transition-colors">Ratgeber</a>
        </div>

        <!-- Controls: Live Price Callout + Solar/Lunar Toggle -->
        <div class="flex items-center gap-3">
          {currentPrice !== undefined && (
            <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-100/60 dark:bg-slate-900/60">
              <span class={`w-2 h-2 rounded-full ${currentAmpel === 'red' ? 'bg-rose-500' : currentAmpel === 'yellow' ? 'bg-amber-400' : 'bg-emerald-400'} animate-pulse`}></span>
              <span class="text-xs font-mono font-bold text-slate-900 dark:text-white">{currentPrice.toFixed(2)} ct</span>
            </div>
          )}

          <!-- Solar / Lunar Toggle -->
          <ThemeToggle />

          <a
            href="/rechner/"
            class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold rounded-xl transition shadow-xs"
          >
            Tarif vergleichen →
          </a>
        </div>
      </div>
    </nav>

    <!-- Page Content Slot -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-950 text-slate-400 border-t border-slate-900 pt-16 pb-12 mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-slate-800">
          <!-- Col 1: About & Source -->
          <div class="lg:col-span-2 space-y-4">
            <div class="flex items-center gap-2">
              <span class="text-xl">⚡</span>
              <span class="font-bold text-white text-base">StrompreiseHeute.de</span>
            </div>
            <p class="text-xs text-slate-400 leading-relaxed">
              Unabhängiges Informationsportal für stündliche Börsenstrompreise (Day-Ahead Auktion EPEX Spot SE) und dynamische Stromtarife in Deutschland. Datenquelle: Bundesnetzagentur / SMARD.de Open Data.
            </p>
            <div class="text-[11px] text-slate-400 bg-slate-900 border border-slate-800 p-3 rounded-xl">
              Alle Angaben ohne Gewähr. Verbraucherendpreise basieren auf bundesweiten Durchschnittswerten für Netzentgelte, Steuern und Umlagen.
            </div>
          </div>

          <!-- Col 2: Navigation -->
          <div>
            <h4 class="text-white text-xs font-bold uppercase tracking-wider mb-3">Strompreis-Portale</h4>
            <ul class="space-y-2 text-xs">
              <li><a href="/" class="hover:text-amber-400 transition">Börsenstrom Heute (24h)</a></li>
              <li><a href="/stromampel/" class="hover:text-amber-400 transition">Live Stromampel Deutschland</a></li>
              <li><a href="/morgen/" class="hover:text-amber-400 transition">Strompreise für morgen</a></li>
              <li><a href="/rechner/" class="hover:text-amber-400 transition">Dynamischer Tarif Rechner</a></li>
              <li><a href="/ratgeber/" class="hover:text-amber-400 transition">Ratgeber: Was ist Börsenstrom?</a></li>
            </ul>
          </div>

          <!-- Col 3: Bundesländer -->
          <div>
            <h4 class="text-white text-xs font-bold uppercase tracking-wider mb-3">Bundesländer</h4>
            <ul class="space-y-2 text-xs">
              <li><a href="/bundesland/bayern/" class="hover:text-amber-400 transition">Bayern (München)</a></li>
              <li><a href="/bundesland/nordrhein-westfalen/" class="hover:text-amber-400 transition">NRW (Köln / Düsseldorf)</a></li>
              <li><a href="/bundesland/baden-wuerttemberg/" class="hover:text-amber-400 transition">Baden-Württemberg (Stuttgart)</a></li>
              <li><a href="/bundesland/berlin/" class="hover:text-amber-400 transition">Berlin (Stadtnetz)</a></li>
              <li><a href="/bundesland/hamburg/" class="hover:text-amber-400 transition">Hamburg (Windstrom)</a></li>
              <li><a href="/bundesland/hessen/" class="hover:text-amber-400 transition">Hessen (Frankfurt)</a></li>
            </ul>
          </div>

          <!-- Col 4: European Network & Legal -->
          <div>
            <h4 class="text-white text-xs font-bold uppercase tracking-wider mb-3">Europäisches Netzwerk</h4>
            <ul class="space-y-1.5 text-[11px] mb-4">
              <li><a href="https://spritchecker.de" target="_blank" rel="noopener" class="hover:text-amber-400 transition">🇩🇪 SpritChecker.de (Benzinpreise)</a></li>
              <li><a href="https://fernsehheute.de" target="_blank" rel="noopener" class="hover:text-amber-400 transition">🇩🇪 FernsehHeute.de (TV-Programm)</a></li>
              <li><a href="https://housepricespro.co.uk" target="_blank" rel="noopener" class="hover:text-amber-400 transition">🇬🇧 HousePricesPro.co.uk (Property)</a></li>
              <li><a href="https://checkmotpro.co.uk" target="_blank" rel="noopener" class="hover:text-amber-400 transition">🇬🇧 CheckMOTPro.co.uk (MOT & Tax)</a></li>
              <li><a href="https://pumpchecker.co.uk" target="_blank" rel="noopener" class="hover:text-amber-400 transition">🇬🇧 PumpChecker.co.uk (Fuel)</a></li>
              <li><a href="https://prezzobenza.it" target="_blank" rel="noopener" class="hover:text-amber-400 transition">🇮🇹 PrezzoBenza.it (Benzina)</a></li>
            </ul>

            <div class="flex flex-wrap gap-3 pt-2 border-t border-slate-800 text-xs">
              <a href="/impressum/" class="hover:text-white transition">Impressum</a>
              <span>•</span>
              <a href="/datenschutz/" class="hover:text-white transition">Datenschutz</a>
            </div>
          </div>
        </div>

        <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
          <div>
            © {new Date().getFullYear()} StrompreiseHeute.de — Alle Rechte vorbehalten.
          </div>
          <div class="flex items-center gap-4">
            <span>Bundesnetzagentur SMARD Open Data</span>
            <span>•</span>
            <span>EPEX Spot SE Auktionsdaten</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Cookie Consent Banner -->
    <ConsentBanner />
  </body>
</html>
